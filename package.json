{
  "name": "ultra-next-template",
  "version": "1.0.0",
  "description": "Production-minded Next.js frontend starter with typed API boundaries, TanStack Query, i18n, Storybook and tests.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.ts",
    "analyze": "next experimental-analyze",
    "analyze:output": "next experimental-analyze --output",
    "audit:dependencies": "pnpm audit --prod --audit-level high --ignore-registry-errors",
    "lint": "eslint . --max-warnings 0",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:visual:docker": "node scripts/run-visual-tests-docker.ts",
    "test:visual:update:docker": "node scripts/run-visual-tests-docker.ts --update",
    "performance:check": "pnpm build && lhci autorun --config=.lighthouserc.cjs",
    "icons:generate": "svgr --out-dir src/components/icons/generated -- assets/icons && prettier --write src/components/icons/generated",
    "icons:check": "node scripts/check-generated-icons.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^9.2.4",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.16",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.19.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
